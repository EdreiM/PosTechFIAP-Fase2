# Copie este arquivo para .env e preencha os valores.
# A IA (Groq) é OPCIONAL: sem chave ou sem o pacote groq, o sistema usa textos locais.

# Chave da API Groq (opcional, recomendada para análise/relatórios/chat via LLM)
GROQ_API_KEY=

# Opcional: modelo Groq (padrão: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Opcional: força o modo offline (usa textos locais, não chama a API)
# GROQ_DESABILITADO=1

